# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# Required: your Google Gemini API key
GEMINI_API_KEY=your-key-here

# Optional: Gemini model to use (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional: set to "production" to disable /docs and /redoc endpoints
APP_ENV=development

# Optional: comma-separated allowed origins for CORS (defaults to same-origin)
# CORS_ORIGINS=https://yourdomain.com

# Optional: rate limit (requests per minute per IP, default 20)
# RATE_LIMIT_RPM=20
